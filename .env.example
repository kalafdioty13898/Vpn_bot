# ================= ربات فروش VPN =================
# این فایل را به نام .env کپی کنید و مقادیر واقعی را بگذارید.
# ⚠️ فایل .env هرگز نباید به گیت‌هاب پوش شود (در .gitignore هست).

# توکن ربات (از @BotFather)
BOT_TOKEN=

# شناسه عددی ادمین‌ها، جدا شده با کاما (اولی = سوپر ادمین)
# ⚠️ روی GitHub Actions این مقدار از Secret با نام ADMIN_IDS خوانده می‌شود،
#    نه از این فایل. در Settings → Secrets and variables → Actions آن را بسازید.
ADMIN_IDS=1051928416

# دیتابیس:
#   توسعه/سرور ساده:   sqlite+aiosqlite:///./vpnbot.db
#   PostgreSQL:        postgresql+asyncpg://user:pass@host:5432/vpnbot
DATABASE_URL=sqlite+aiosqlite:///./vpnbot.db

# منطقه زمانی
TIMEZONE=Asia/Tehran

# سطح لاگ: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- پنل VPN ---
# حالت اتصال به پنل: mock (تست، کانفیگ نمونه می‌سازد) یا pasargad
PANEL_MODE=mock
PANEL_URL=
PANEL_API_URL=
PANEL_API_KEY=
PANEL_USERNAME=
PANEL_PASSWORD=
